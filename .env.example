# Copy to .env.local for local dev. In Vercel, set these under Project Settings > Environment Variables.
# Never commit real values.

# --- Supabase (Phase 1) ---
# Project URL, from Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). Safe in the browser because RLS protects every table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (sb_secret_...). Server only, bypasses RLS; used only by the cron jobs. Never expose it.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Auth (Phase 1) ---
# The only email allowed to sign up or sign in. Must match private.app_config in the database.
ALLOWED_EMAIL=you@example.com

# --- Google (Phases 2-3) ---
# Google Cloud API key with Places API (New) enabled. Server only. Restrict it to Places API (New).
GOOGLE_PLACES_API_KEY=
# Hard daily cap on Places API requests (town lookups, search pages, refreshes). 30/day stays near Google's free tier.
MAX_PLACES_REQUESTS_PER_DAY=30
# Optional. PageSpeed Insights works without a key at a low quota; a key raises it to 25k/day.
GOOGLE_PAGESPEED_API_KEY=

# --- External SEO scorer (Phase 3, optional) ---
# If both are set, site scoring calls this endpoint instead of the built-in scorer.
SEO_TOOL_URL=
# API key sent to SEO_TOOL_URL.
SEO_TOOL_API_KEY=

# --- Outreach (Phase 5) ---
# Mailing address added to every email draft (CAN-SPAM). Email drafts are blocked while this is empty.
BUSINESS_MAILING_ADDRESS=
# Optional. Enables the "Rewrite with Claude" button on drafts. Leave empty to use templates only.
ANTHROPIC_API_KEY=

# --- Cron (Phase 6) ---
# Random string; Vercel sends it as "Authorization: Bearer <CRON_SECRET>" to the cron routes.
CRON_SECRET=
